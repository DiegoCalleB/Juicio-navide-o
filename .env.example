NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Opcional: si falta, se usa el dominio público de Railway
NEXT_PUBLIC_SITE_URL=https://mensajeria-magica.up.railway.app
# openssl rand -hex 32  (solo servidor)
FINGERPRINT_SALT=change-me-to-a-long-random-secret

# ── Mensajería Real de Oriente (solo servidor, NUNCA con NEXT_PUBLIC_) ──
# Supabase → Project Settings → API Keys → Secret key (sb_secret_…) o la service_role legacy
SUPABASE_SECRET_KEY=sb_secret_xxx
# ElevenLabs → Developers → API Keys (permiso Text to Speech)
ELEVENLABS_API_KEY=xxx

# ── Limpieza automática de salas caducadas ──
# Cualquier valor largo y aleatorio (openssl rand -hex 32). Lo usa el programador que llame a /api/cron/cleanup
CRON_SECRET=xxx
# ── Interruptores (se leen al compilar) ──
# 1 = el personaje contesta también con voz sintetizada (requiere ELEVENLABS_API_KEY). Por ahora, sin definir.
NEXT_PUBLIC_ENABLE_VOICE=
# Los audios del niño están activos por defecto; 0 los apaga.
NEXT_PUBLIC_ENABLE_CHILD_AUDIO=

# ── Voz del personaje (fase 2) ──
# Cambiar una voz sin tocar código: voice_id de la biblioteca de ElevenLabs
ELEVENLABS_VOICE_PAPA_NOEL=
ELEVENLABS_VOICE_MELCHOR=
ELEVENLABS_VOICE_GASPAR=
ELEVENLABS_VOICE_BALTASAR=
# Topes de coste: respuestas con voz por sala y día, y caracteres por día en toda la app
VOICE_ROOM_DAILY_LIMIT=40
VOICE_DAILY_CHAR_LIMIT=150000
# ── Pagos: prueba gratis de 3 días + Pase de Navidad (Stripe) ──
# Sin STRIPE_SECRET_KEY todo sigue gratis y sin límites. Con ella se activan la prueba y el pase.
# Stripe → Developers → API keys → Secret key (sk_live_… o sk_test_… para probar)
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://TU-DOMINIO/api/stripe/webhook
#   eventos: checkout.session.completed y checkout.session.async_payment_succeeded → "Signing secret" (whsec_…)
STRIPE_WEBHOOK_SECRET=
# Secreto para derivar los enlaces de pase (openssl rand -hex 32). Si falta se usa FINGERPRINT_SALT.
# OJO: no cambiarlo una vez haya pases vendidos (los enlaces dejarían de reconstruirse en la página de pago).
PASS_SECRET=
# Opcional: precios en céntimos (IVA incluido) y fin del precio de lanzamiento (AAAA-MM-DD, ese día ya no aplica)
PASS_PRICE_LAUNCH_CENTS=399
PASS_PRICE_CENTS=499
PASS_LAUNCH_UNTIL=2026-12-01

# ── Legal ──
# Correo de contacto que aparece en Privacidad y Términos
NEXT_PUBLIC_CONTACT_EMAIL=
